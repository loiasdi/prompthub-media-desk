{
  "name": "prompthub-media-desk",
  "version": "2.6.2",
  "description": "PromptHub MediaDesk 自媒体工作台：从灵感讨论、大纲改稿，到视频提示词、配图封面、素材归档与发布管理。",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "prompthub",
    "media-desk",
    "content-creation"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "preview": "node --watch scripts/preview.mjs",
    "test": "node --test test/*.test.js",
    "assets": "python3 scripts/gen-assets.py",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "THIRD-PARTY-NOTICES.txt",
    "docs/local-publishing-entry.md",
    "docs/local-bilibili-publishing-plan.md",
    "docs/local-youtube-publishing-plan.md",
    "docs/local-bluesky-publishing.md",
    "docs/local-kuaishou-publishing.md",
    "docs/local-facebook-reels.md",
    "docs/local-instagram-reels.md",
    "docs/local-douyin-publishing.md",
    "docs/local-linkedin-publishing.md",
    "docs/local-x-publishing.md",
    "docs/local-pinterest-publishing.md",
    "docs/local-tiktok-publishing.md",
    "docs/local-threads-publishing.md",
    "docs/local-wechat-publishing.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loiasdi/prompthub-media-desk.git"
  },
  "homepage": "https://github.com/loiasdi/prompthub-media-desk#readme",
  "bugs": {
    "url": "https://github.com/loiasdi/prompthub-media-desk/issues"
  },
  "dependencies": {
    "twitter-text": "3.1.0"
  }
}
